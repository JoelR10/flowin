# Puerto del server (opcional, default 8787)
PORT=8787

# Monitoreo del server (Sentry, opcional). Vacío = sin Sentry.
SENTRY_DSN=

# Seguridad para PRODUCCIÓN (en local podés dejarlo vacío):
# - ALLOWED_ORIGINS: orígenes permitidos, separados por coma. Vacío = abierto (warning).
#   Ej: https://flowin.tudominio.com,https://www.tudominio.com
ALLOWED_ORIGINS=
# - APP_TOKEN: si lo definís, el cliente debe mandar el mismo token (header x-flowin-token).
#   Útil para que tu server con keys no sea un relay abierto.
APP_TOKEN=

# API keys OPCIONALES del lado servidor. Si las ponés acá, el cliente no
# necesita pegar su key (el proxy usa estas como fallback). Si las dejás
# vacías, el cliente manda su propia key y el server solo la reenvía.
# OJO: si ponés keys acá Y dejás CORS abierto sin APP_TOKEN, cualquiera podría
# gastar tus créditos. Para deploy público usá ALLOWED_ORIGINS + APP_TOKEN.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
