# Puerto del server (opcional, default 8787)
PORT=8787

# Monitoreo del server (Sentry, opcional). Vacío = sin Sentry.
SENTRY_DSN=

# Seguridad para PRODUCCIÓN (en local podés dejarlo vacío):
# - ALLOWED_ORIGINS: orígenes permitidos, separados por coma. Vacío = abierto (warning).
#   Ej: https://flowin.tudominio.com,https://www.tudominio.com
ALLOWED_ORIGINS=
# - APP_TOKEN: si lo definís, el cliente debe mandar el mismo token (header x-flowin-token).
#   Útil para que tu server con keys no sea un relay abierto.
APP_TOKEN=

# API keys del lado servidor (LO MÁS FÁCIL para el usuario).
# Si ponés una key acá, TODOS los usuarios logueados tienen IA con CERO config:
# no pegan ninguna clave; la app detecta el server (/api/ai/status) y muestra
# "IA lista vía el servidor". Vos (dueño) pagás el uso; protegelo con login
# (M6) + rate-limit (ya activos) + ALLOWED_ORIGINS + APP_TOKEN en producción.
# Si las dejás vacías, cada usuario pega su propia key (modo BYO).
# Gemini tiene tier gratis → ponés tu key de Google AI Studio y listo, gratis.
# OJO: keys acá + CORS abierto sin APP_TOKEN = cualquiera gasta tus créditos.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
