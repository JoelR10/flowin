{
  "name": "flowin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "author": "JITO",
  "main": "electron/main.cjs",
  "description": "Flowin — suite de coaches personales (web PWA + móvil vía Capacitor)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "server": "node --env-file-if-exists=server/.env server/index.js",
    "serve": "npm run build && npm run server",
    "electron:dev": "electron .",
    "electron:pack": "electron-builder --win portable",
    "cap:sync": "cap sync",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios"
  },
  "build": {
    "appId": "com.flowin.app",
    "productName": "Flowin",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**",
      "dist/**"
    ],
    "win": {
      "target": "portable",
      "icon": "public/icons/icon-512.png"
    },
    "portable": {
      "artifactName": "Flowin-${version}-portable.exe"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@clerk/clerk-react": "^5.61.8",
    "@clerk/localizations": "^4.7.2",
    "@sentry/node": "^10.56.0",
    "@sentry/react": "^10.56.0",
    "@supabase/supabase-js": "^2.108.0",
    "express": "^4.21.2",
    "localforage": "^1.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5"
  }
}
