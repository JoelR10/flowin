# --- Login (Clerk) ---
# Publishable key de tu app en Clerk (Dashboard → API Keys → empieza con pk_).
# Es PÚBLICA: segura de poner en el cliente. NUNCA pongas la secret key (sk_) acá.
# Si queda VACÍA, la app corre en modo local (sin login).
# Si la completás, se activa el LOGIN OBLIGATORIO con Google + correo.
VITE_CLERK_PUBLISHABLE_KEY=

# --- Base de datos / sync (Supabase, opcional) ---
# URL y anon key de tu proyecto Supabase (Project Settings → API).
# Supabase se usa SOLO como base de datos; la identidad la da Clerk.
# Requiere configurar Clerk como Third-Party Auth en Supabase (ver
# supabase/migrations/0002_clerk_auth.sql). Vacías = sin sync (datos locales).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Monitoreo (Sentry, opcional) ---
# DSN del proyecto Sentry (React). Vacío = sin Sentry.
VITE_SENTRY_DSN=
